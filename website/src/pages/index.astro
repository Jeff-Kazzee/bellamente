---
// Bellamente — "La Macchina" (design B, the chosen direction; see design-preview.html for provenance).
// One self-contained page: the .db-* CSS block and markup are ported verbatim from the preview,
// minus the A/B switcher chrome. Memory with evidence: the terminal is the hero.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bellamente — Memoria Viva for your AI agents</title>
    <meta
      name="description"
      content="Local-first memory for AI agents. Every recall visible, every correction versioned, everything on your machine."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='6' fill='%23c4703a'/%3E%3Ccircle cx='16' cy='16' r='13' fill='none' stroke='%234fa487' stroke-opacity='.5' stroke-width='1.5'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <main class="db">
      <div class="wrap">
        <!-- section: nav -->
        <header class="db-nav">
          <a class="db-logo" href="#">Bella<span>mente</span></a>
          <nav aria-label="primary">
            <a href="#db-proof">Proof</a>
            <a href="#db-articles">Articles</a>
            <a href="https://github.com/Jeff-Kazzee/bellamente">GitHub</a>
            <a class="cta" href="#db-hero">Download</a>
          </nav>
        </header>

        <!-- section: hero -->
        <section class="db-hero" id="db-hero">
          <p class="db-kicker">$ local-first memory for AI agents</p>
          <h1>
            Memory you can read.
            <span class="thin">Every recall scored. Every correction versioned. Every byte on your machine.</span>
          </h1>
          <p class="tagline">Memoria Viva for your AI agents.</p>
          <div class="db-actions">
            <a class="db-btn primary" href="#db-hero" aria-disabled="true">Download — coming with v0.0.1</a>
            <a class="db-btn ghost" href="https://github.com/Jeff-Kazzee/bellamente">Source on GitHub</a>
          </div>
          <p class="db-platnote">one binary · no Docker · no account · macOS/Linux soon</p>

          <!-- signature: the terminal, typing itself -->
          <div class="db-term" aria-label="Terminal demo: starting bella, storing a memory, recalling it with a score">
            <div class="bar"><i></i><i></i><i></i>&nbsp;bella — 127.0.0.1</div>
            <pre id="db-typer"><span class="p">$</span> bella serve
<span class="cm">bellamente listening on 127.0.0.1:8080</span>

<span class="p">$</span> curl -s :8080/memories -H <span class="cp">"authorization: Bearer $BELLA_API_KEY"</span> \
    -d <span class="cp">'&lbrace;"memories":[&lbrace;"content":"Jeff prefers dark mode"&rbrace;]&rbrace;'</span>
<span class="cm">created · v1 · a7Kd…</span>

<span class="p">$</span> curl -s :8080/search -d <span class="cp">'&lbrace;"q":"what theme does Jeff like?"&rbrace;'</span>
<span class="cm">0.94 · "Jeff prefers dark mode" · 12ms · trace 9fQ2…</span> <span class="cursor" aria-hidden="true"></span></pre>
          </div>
        </section>

        <!-- section: pillars as evidence ledger -->
        <section class="db-pillars" id="db-proof">
          <div class="db-row">
            <span class="k">INSPECT</span>
            <div>
              <h3>The trace is the product</h3>
              <p>
                Every recall is durably logged: what was searched, what matched, at what score, in how many
                milliseconds — and what fell below the floor.
              </p>
            </div>
            <div><span class="proof">GET /inspect → scores, latency, provenance</span></div>
          </div>
          <div class="db-row">
            <span class="k">CORRECT</span>
            <div>
              <h3>Nothing silently overwritten</h3>
              <p>
                Edits create new versions with the old ones kept in the chain. Forgetting is reversible and audited.
                Hard delete is the only eraser, and it says so.
              </p>
            </div>
            <div><span class="proof">PATCH /memories/:id → v2 (v1 kept)</span></div>
          </div>
          <div class="db-row">
            <span class="k">LOCAL</span>
            <div>
              <h3>Your machine is the cloud</h3>
              <p>
                Embedded Postgres + pgvector, local embedding models, loopback binding by default. There is no server
                to trust because there is no server.
              </p>
            </div>
            <div><span class="proof">bind 127.0.0.1 · 0 telemetry · 1 binary</span></div>
          </div>
        </section>

        <!-- section: proxy -->
        <section class="db-proxy">
          <div>
            <h2>Drop-in memory for any OpenAI-compatible client</h2>
            <p>
              Change one base URL. Bellamente sits between your agent and your local model, injecting relevant
              memories into the request and writing a trace of exactly what it did. No SDK. No code changes. No
              network egress.
            </p>
          </div>
          <div class="db-flow" role="img" aria-label="Request flow diagram">
            <div class="hop">your agent <b>→ http://127.0.0.1:8080/v1</b></div>
            <div class="hop">bella: search memories · inject top hits · <b>record trace</b></div>
            <div class="hop">→ your model server (Ollama · LM Studio · llama.cpp · vLLM)</div>
            <div class="hop">← answer, with <b>x-bella-trace-id</b> for the receipt</div>
          </div>
        </section>

        <!-- section: articles -->
        <section class="db-articles" id="db-articles">
          <h2>Field notes</h2>
          <article class="db-art">
            <span class="date">2026-07</span>
            <h3><a href="#">Your agent's memory should be inspectable</a></h3>
            <span class="read">6 min →</span>
          </article>
          <article class="db-art">
            <span class="date">2026-07</span>
            <h3><a href="#">Memoria Viva: what living memory means</a></h3>
            <span class="read">4 min →</span>
          </article>
          <article class="db-art">
            <span class="date">2026-06</span>
            <h3><a href="#">A proxy that never phones home</a></h3>
            <span class="read">8 min →</span>
          </article>
        </section>

        <!-- section: footer -->
        <footer class="db-footer">
          <span>© 2026 The Little AI Co · BELLAMENTE</span>
          <span class="fine">
            local-first memory for AI agents ·
            <a href="https://github.com/Jeff-Kazzee/bellamente">github.com/Jeff-Kazzee/bellamente</a>
          </span>
        </footer>
      </div>
    </main>
  </body>
</html>

<style is:global>
  /* ============ base ============ */
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #0f2a24; }

  /* =========================================================================
     "La Macchina" · verdigris / bone / oxidized copper
     Memory with evidence: the terminal is the hero.
     ========================================================================= */
  .db {
    --deep: #0f2a24; --panel: #14332c; --edge: #22463d; --bone: #ede6d6;
    --bone-dim: #b8b2a2; --copper: #c4703a; --patina: #4fa487; --shadow: #081b16;
    background:
      linear-gradient(180deg, #0c2620 0%, var(--deep) 30%),
      var(--deep);
    color: var(--bone);
    font: 400 16.5px/1.65 "Archivo", sans-serif;
    min-height: 100vh;
  }
  .db ::selection { background: rgba(196,112,58,.45); }
  .db .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .db h1, .db h2 { font-family: "Archivo", sans-serif; font-variation-settings: "wdth" 115; font-weight: 800; margin: 0; letter-spacing: -.005em; }
  .db .mono { font-family: "IBM Plex Mono", monospace; }
  .db a { color: var(--patina); text-decoration: none; }
  .db a:hover { color: var(--bone); }
  .db a:focus-visible, .db button:focus-visible { outline: 2px solid var(--copper); outline-offset: 3px; border-radius: 4px; }

  /* section: nav */
  .db-nav { display: flex; align-items: center; justify-content: space-between; padding: 24px 0; border-bottom: 1px solid var(--edge); }
  .db-logo { font-family: "Archivo", sans-serif; font-variation-settings: "wdth" 120; font-weight: 900; font-size: 19px; letter-spacing: .06em; text-transform: uppercase; color: var(--bone); }
  .db-logo span { color: var(--copper); }
  .db-nav nav { display: flex; gap: 24px; font-size: 14.5px; font-weight: 500; }
  .db-nav .cta { color: var(--deep); background: var(--copper); padding: 9px 16px; border-radius: 6px; font-weight: 700; }
  .db-nav .cta:hover { color: var(--deep); filter: brightness(1.1); }

  /* section: hero — the terminal */
  .db-hero { padding: 70px 0 30px; text-align: left; }
  .db-kicker { font-family: "IBM Plex Mono", monospace; font-size: 13px; color: var(--patina); letter-spacing: .1em; margin-bottom: 16px; }
  .db-hero h1 { font-size: clamp(40px, 6vw, 72px); line-height: 1.02; text-transform: uppercase; max-width: 18ch; }
  .db-hero h1 .thin { font-variation-settings: "wdth" 80; font-weight: 400; color: var(--bone-dim); display: block; font-size: .5em; letter-spacing: .04em; text-transform: none; margin-top: 14px; }
  .db-hero .tagline { font-family: "IBM Plex Mono", monospace; font-style: italic; color: var(--copper); font-size: 17px; margin: 20px 0 0; }
  .db-actions { display: flex; gap: 14px; margin: 34px 0 8px; flex-wrap: wrap; }
  .db-btn { font-weight: 700; font-size: 15px; padding: 13px 22px; border-radius: 8px; }
  .db-btn.primary { background: var(--copper); color: var(--deep); }
  .db-btn.primary:hover { color: var(--deep); filter: brightness(1.1); }
  .db-btn.ghost { border: 1.5px solid var(--edge); color: var(--bone); }
  .db-btn.ghost:hover { border-color: var(--patina); color: var(--bone); }
  .db-platnote { font-family: "IBM Plex Mono", monospace; font-size: 12.5px; color: var(--bone-dim); }

  .db-term { margin: 44px 0 0; background: var(--shadow); border: 1px solid var(--edge); border-radius: 12px; overflow: hidden; box-shadow: 0 30px 70px rgba(0,0,0,.45); }
  .db-term .bar { display: flex; align-items: center; gap: 8px; padding: 11px 16px; border-bottom: 1px solid var(--edge); font-family: "IBM Plex Mono", monospace; font-size: 12px; color: var(--bone-dim); }
  .db-term .bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--edge); }
  .db-term .bar i:first-child { background: var(--copper); }
  .db-term pre { margin: 0; padding: 22px 24px 26px; font-family: "IBM Plex Mono", monospace; font-size: 14.5px; line-height: 1.85; overflow-x: auto; color: var(--bone); }
  .db-term .p { color: var(--patina); } .db-term .cm { color: #6f8b80; } .db-term .cp { color: var(--copper); }
  .db-term .cursor { display: inline-block; width: 8px; height: 17px; background: var(--copper); vertical-align: -3px; animation: db-blink 1.1s steps(1) infinite; }
  @keyframes db-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .db-term .cursor { animation: none; } }

  /* section: pillars (ledger rows, not cards) */
  .db-pillars { padding: 70px 0 20px; }
  .db-row { display: grid; grid-template-columns: 190px 1fr 1fr; gap: 28px; padding: 30px 0; border-top: 1px solid var(--edge); align-items: baseline; }
  .db-row .k { font-family: "IBM Plex Mono", monospace; color: var(--copper); font-size: 13.5px; letter-spacing: .08em; }
  .db-row h3 { font-family: "Archivo", sans-serif; font-variation-settings: "wdth" 110; font-weight: 700; font-size: 21px; margin: 0; color: var(--bone); }
  .db-row p { margin: 0; color: var(--bone-dim); font-size: 15.5px; }
  .db-row .proof { font-family: "IBM Plex Mono", monospace; font-size: 13px; color: var(--patina); display: block; margin-top: 10px; }

  /* section: proxy */
  .db-proxy { margin: 60px 0; border: 1px solid var(--edge); border-radius: 14px; padding: 44px; background: var(--panel); display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .db-proxy h2 { font-size: 28px; }
  .db-proxy p { color: var(--bone-dim); }
  .db-flow { font-family: "IBM Plex Mono", monospace; font-size: 13.5px; display: grid; gap: 0; }
  .db-flow .hop { padding: 13px 16px; border: 1px solid var(--edge); background: var(--shadow); }
  .db-flow .hop:first-child { border-radius: 10px 10px 0 0; }
  .db-flow .hop:last-child { border-radius: 0 0 10px 10px; }
  .db-flow .hop + .hop { border-top: 0; }
  .db-flow .hop b { color: var(--copper); font-weight: 500; }

  /* section: articles */
  .db-articles { padding: 10px 0 70px; }
  .db-articles h2 { font-size: 28px; margin-bottom: 8px; }
  .db-art { display: grid; grid-template-columns: 110px 1fr auto; gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--edge); align-items: baseline; }
  .db-art .date { font-family: "IBM Plex Mono", monospace; font-size: 13px; color: var(--bone-dim); }
  .db-art h3 { margin: 0; font-size: 19px; font-weight: 700; font-variation-settings: "wdth" 108; }
  .db-art h3 a { color: var(--bone); }
  .db-art h3 a:hover { color: var(--copper); }
  .db-art .read { font-family: "IBM Plex Mono", monospace; font-size: 13px; color: var(--patina); white-space: nowrap; }

  /* section: footer */
  .db-footer { border-top: 1px solid var(--edge); padding: 28px 0 96px; display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; font-family: "IBM Plex Mono", monospace; font-size: 13px; color: var(--bone-dim); }
  .db-footer .fine { max-width: 66ch; }

  @media (max-width: 880px) {
    .db-proxy { grid-template-columns: 1fr; padding: 30px 22px; }
    .db-row { grid-template-columns: 1fr; gap: 10px; }
    .db-art { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
