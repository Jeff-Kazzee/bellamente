# Required
MINIMEM_API_KEY=change-me

# Database (M1 dev): external Postgres with pgvector. (M2 -> embedded PGlite.)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/minimem

# Embeddings ------------------------------------------------------------------
# Default = local, in-process (no cloud, no server). Model chosen by A/B (bun run bench):
# bge-base-en-v1.5 (MIT, 109M, 768-d native) ties Qwen3-0.6B on English retrieval at ~7x
# the speed and ~5.5x smaller. Each model has a built-in pooling/prompt profile in src/embed.ts.
EMBEDDING_PROVIDER=local
LOCAL_EMBED_MODEL=Xenova/bge-base-en-v1.5
LOCAL_EMBED_DTYPE=q8
EMBED_DIM=768
MINIMEM_SKIP_EMBEDDING_PREWARM=0

# Opt-in models (uncomment one):
#  multilingual + 32K context, heavier (~5x): LOCAL_EMBED_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX   (keep EMBED_DIM=768)
#  ultralight 33M / 384-d:                     LOCAL_EMBED_MODEL=Xenova/bge-small-en-v1.5                  (set EMBED_DIM=384 + schema vector(384))

# Optional cloud fallback (set EMBEDDING_PROVIDER=openai):
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Server ----------------------------------------------------------------------
PORT=8080
SEARCH_THRESHOLD=0.4
ORG_ID=sm_default_org
DEFAULT_CONTAINER_TAG=sm_project_default
