# Required
MINIMEM_API_KEY=change-me

# Database (M1 dev): external Postgres with pgvector. (M2 -> embedded PGlite.)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/minimem

# Embeddings ------------------------------------------------------------------
# Default = local, in-process, no cloud, no server: Qwen3-Embedding via transformers.js (ONNX).
# Prewarmed at boot; first run downloads the model to the HF cache.
EMBEDDING_PROVIDER=local

# Model size (Qwen3-Embedding). DEFAULT = 0.6B: light, fast on CPU, recommended for in-process.
#   0.6B  native 1024d  ~600MB(q8)  ~1-1.5GB RAM  fast on CPU          <- default
#   4B    native 2560d  ~4GB(q8)    ~4-6GB RAM    slow on CPU (wants a GPU)
# Both are instruction-aware and MRL-truncate to EMBED_DIM (768), so the schema is unchanged.
LOCAL_EMBED_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
# Heavier / higher-quality opt-in (only if you have the RAM / a GPU):
# LOCAL_EMBED_MODEL=onnx-community/Qwen3-Embedding-4B-ONNX

LOCAL_EMBED_DTYPE=q8
EMBED_QUERY_INSTRUCTION=Given a search query, retrieve relevant memories and passages that answer the query
EMBED_DIM=768
MINIMEM_SKIP_EMBEDDING_PREWARM=0

# Optional cloud fallback (set EMBEDDING_PROVIDER=openai to use):
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Server ----------------------------------------------------------------------
PORT=8080
SEARCH_THRESHOLD=0.4
ORG_ID=sm_default_org
DEFAULT_CONTAINER_TAG=sm_project_default
