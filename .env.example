# Required
MINIMEM_API_KEY=change-me

# Dev (M1): external Postgres with pgvector
DATABASE_URL=postgres://postgres:postgres@localhost:5432/minimem

# Embeddings: local (M2 bundled model) or openai (dev fallback)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional
PORT=8080
SEARCH_THRESHOLD=0.4
MINIMEM_SKIP_EMBEDDING_PREWARM=0
ORG_ID=sm_default_org
DEFAULT_CONTAINER_TAG=sm_project_default
