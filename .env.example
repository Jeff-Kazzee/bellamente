# Required
MINIMEM_API_KEY=change-me

# Database (M1 dev): external Postgres with pgvector. (M2 -> embedded PGlite.)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/minimem

# Embeddings ------------------------------------------------------------------
# Default = local, in-process, no cloud, no server: Qwen3-Embedding-0.6B via
# transformers.js (ONNX). First run downloads the model (~600MB at q8) to the
# HF cache, then it is prewarmed at boot.
EMBEDDING_PROVIDER=local
LOCAL_EMBED_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
LOCAL_EMBED_DTYPE=q8
# Query-side instruction (Qwen3 is instruction-aware; documents are embedded raw).
EMBED_QUERY_INSTRUCTION=Given a search query, retrieve relevant memories and passages that answer the query
# Output dim (Qwen3 MRL truncates to this). Must match schema.sql vector(N).
EMBED_DIM=768
# Skip the boot-time model warmup (first request then pays the load cost).
MINIMEM_SKIP_EMBEDDING_PREWARM=0

# Optional cloud fallback (set EMBEDDING_PROVIDER=openai to use):
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Server ----------------------------------------------------------------------
PORT=8080
SEARCH_THRESHOLD=0.4
ORG_ID=sm_default_org
DEFAULT_CONTAINER_TAG=sm_project_default
