# Bellamente configuration. BELLA_* are the only names.

# Required
BELLA_API_KEY=change-me

# Database ---------------------------------------------------------------------
# Default = embedded PGlite (Postgres compiled to WASM) running IN-PROCESS. Zero config, no Docker, no
# server: data lives on disk under the data dir (see STORAGE.md). Nothing to set here for the default.
#
# ADVANCED OVERRIDE — use an external Postgres+pgvector instead (dev / power users):
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/bellamente
#
# NOTE: switching EMBED_DIM on an EXISTING install is NOT automatic — the tables keep their original
# dimension and the server refuses to start with a clear error. To change it, delete the DB (the `db`
# folder under the data dir; see STORAGE.md) to recreate at the new dimension, or migrate/re-embed.
#
# Embedded-DB memory (bounded + device-scaled by default):
# BELLA_DB_SHARED_BUFFERS_MB=   # override Postgres shared_buffers (auto default ~2% RAM cap 128; clamped 32..512)
# BELLA_DB_RELAXED_DURABILITY=0 # 1 = defer fsync for faster writes (default 0 = durable/crash-safe)

# Embeddings ------------------------------------------------------------------
# Local + in-process (no cloud, no server). The embedder is DEVICE-SCALED, so leave the model UNSET:
#   - "quality" tier = multilingual-e5-small (WASM, 384-d): best score + multilingual, on capable machines.
#   - "light" tier   = potion-retrieval-32M (static Model2Vec, 512-d, ~440MB, NEVER crashes): auto-selected on
#     low-RAM machines (< ~7GB total) so old laptops don't hard-crash the threaded-WASM engine.
EMBEDDING_PROVIDER=local
BELLA_SKIP_EMBEDDING_PREWARM=0
# BELLA_EMBED_TIER=          # quality | light  (default: auto by total device RAM)
# BELLA_EMBED_MIN_RAM_GB=7   # below this total RAM, auto picks the light tier
#   NOTE: auto-detection reads TOTAL HOST RAM (not cgroup/container limits). In a memory-capped container/VM,
#   set BELLA_EMBED_TIER=light explicitly. The chosen model+dim is pinned at first DB init (data dir), so a
#   later RAM/hardware change won't flip it and break your stored memories.
# LOCAL_EMBED_DTYPE=q8        # WASM-engine weight dtype (the static engine ignores it)

# Pin a specific model (wins over the tier; EMBED_DIM auto-follows a known model). On an existing install,
# delete the DB folder first — a dimension change is NOT automatic (the server refuses to boot on mismatch):
#   English, low-RAM (static):   LOCAL_EMBED_MODEL=minishlab/potion-retrieval-32M       (dim 512)
#   Multilingual, low-RAM:       LOCAL_EMBED_MODEL=minishlab/potion-multilingual-128M   (dim 256; ~1.8GB tokenizer)
#   Higher-quality English:      LOCAL_EMBED_MODEL=Xenova/bge-base-en-v1.5              (dim 768)
#   768-d multilingual (WASM):   LOCAL_EMBED_MODEL=Xenova/multilingual-e5-base          (dim 768)
# LOCAL_EMBED_MODEL=
# EMBED_DIM=                    # only for an unlisted model; must match the DB

# Optional cloud fallback for embeddings (set EMBEDDING_PROVIDER=openai):
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Chat proxy upstream (POST /v1/chat/completions). Defaults to local Ollama-compatible /v1.
# Set BELLA_UPSTREAM_BASE_URL for LM Studio / llama.cpp / vLLM / another local server.
# Non-local upstreams must opt in explicitly with BELLA_UPSTREAM_API_KEY or x-bella-upstream-api-key.
# BELLA_UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1
# BELLA_UPSTREAM_API_KEY=
# BELLA_UPSTREAM_TIMEOUT_MS=120000      # deadline for buffered upstream exchanges
# BELLA_STREAM_IDLE_TIMEOUT_MS=120000   # stall detector for streamed responses
# BELLA_PROXY_INJECT_ONLY=0 # 1 = only inject tool/profile and do not call upstream (debug/compat mode)

# Auto-capture: the proxy remembers durable first-person facts from your chats ("I prefer...",
# "my editor is...") through the SAME dedup path as manual writes. Every capture is traced
# (dashboard -> Traces -> capture), tagged is_inference + source=proxy_capture, and reversible.
# Credentials / financial IDs / medical disclosures are excluded and never stored.
# BELLA_PROXY_CAPTURE=1   # default ON; set 0 to disable entirely

# Memory write tuning ----------------------------------------------------------
# BELLA_SUPERSEDE_THRESHOLD=   # cosine floor for supersede-on-write (default 0.95 wasm/OpenAI, 0.98 static)
# BELLA_FORGET_SWEEP_INTERVAL_MS=3600000  # forget_after expiry sweep interval (0 disables; floor 60s)

# Resource safety -------------------------------------------------------------
# Soft disk cap in MB (0 = unlimited). `bella doctor` reports usage; boot warns if exceeded.
BELLA_DISK_BUDGET_MB=0
# Recall/proxy trace retention. Default keeps the latest 1000 traces; 0 disables pruning.
# BELLA_TRACE_RETENTION=1000
# Max text stored per trace item/query (clamped 80..5000). Prevents trace rows from duplicating huge prompts.
# BELLA_TRACE_TEXT_LIMIT=1200
# Model download timeout in ms for the first-run weights fetch (default 300000).
# BELLA_MODEL_DOWNLOAD_TIMEOUT_MS=300000
# Embed worker round-trip timeout in ms (default 120000).
# BELLA_EMBED_TIMEOUT_MS=120000
# NOTE: the WASM embedding engine runs SINGLE-THREADED by design (multi-thread WASM hangs under Bun).
# There is no thread knob; do not set BELLA_ONNX_THREADS — it has no effect.

# Storage location overrides (defaults = per-OS app dirs via env-paths; see docs/STORAGE.md).
# BELLA_HOME=         # everything under one folder (portable install)
# BELLA_DATA_DIR=     # just the data (memories/DB)
# BELLA_CACHE_DIR=    # just the cache (model weights / extracted libs)
# BELLA_LOG_DIR=      # just the logs
# BELLA_MODEL_DIR=    # the model-weights cache directly

# Server ----------------------------------------------------------------------
PORT=8080
# BELLA_HOST=127.0.0.1  # bind address (default loopback; 0.0.0.0 exposes to the LAN)
SEARCH_THRESHOLD=0.4
ORG_ID=bellamente_default_org
DEFAULT_CONTAINER_TAG=default

# Health check:  bella doctor   (verifies DB, model, ports; reports disk usage vs budget)
