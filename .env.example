# Required
EUNOIA_API_KEY=change-me

# Database (M1 dev): external Postgres with pgvector. (M2 -> embedded PGlite.)
# NOTE: switching embedding model dimension (EMBED_DIM) requires recreating the DB tables.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/eunoia

# Embeddings ------------------------------------------------------------------
# Default = local, in-process (no cloud, no server). Chosen by A/B (bun run bench):
# multilingual-e5-small (MIT, 118M, 384-d) ties bge-base on English, is the smallest/fastest,
# and is verified multilingual (100% vs bge 40% on non-Latin cross-lingual retrieval).
EMBEDDING_PROVIDER=local
LOCAL_EMBED_MODEL=Xenova/multilingual-e5-small
LOCAL_EMBED_DTYPE=q8
EMBED_DIM=384
EUNOIA_SKIP_EMBEDDING_PREWARM=0

# Opt-in models (each has a built-in pooling/prompt profile in src/embed.ts).
# Remember to set EMBED_DIM to match and recreate the DB tables:
#   English-only, slightly higher MRR: LOCAL_EMBED_MODEL=Xenova/bge-base-en-v1.5            EMBED_DIM=768
#   768-d multilingual:                LOCAL_EMBED_MODEL=Xenova/multilingual-e5-base         EMBED_DIM=768
#   multilingual + 32K context:        LOCAL_EMBED_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX  EMBED_DIM=768

# Optional cloud fallback (set EMBEDDING_PROVIDER=openai):
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Resource safety -------------------------------------------------------------
# Bounded CPU/memory: cap ONNX thread pools (default 1 = predictable, low footprint).
# Raise for faster bulk ingestion on bigger machines.
EUNOIA_ONNX_THREADS=1
# Soft disk cap in MB (0 = unlimited). `eunoia doctor` reports usage; boot warns if exceeded.
EUNOIA_DISK_BUDGET_MB=0

# Storage location overrides (defaults = per-OS app dirs via env-paths; see docs/STORAGE.md).
# EUNOIA_HOME=         # everything under one folder (portable install)
# EUNOIA_DATA_DIR=     # just the data (memories/DB)
# EUNOIA_CACHE_DIR=    # just the cache (model weights / extracted libs)
# EUNOIA_LOG_DIR=      # just the logs
# EUNOIA_MODEL_DIR=    # the model-weights cache directly

# Server ----------------------------------------------------------------------
PORT=8080
SEARCH_THRESHOLD=0.4
ORG_ID=eunoia_default_org
DEFAULT_CONTAINER_TAG=default

# Health check:  eunoia doctor   (verifies DB, model, ports; reports disk usage vs budget)
